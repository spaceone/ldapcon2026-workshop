# symas openldap monitor config
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'telegraf'
    scrape_interval: 10s
    static_configs:
      - targets: [{% for host in groups['openldap'] %}'{{ host }}:9100'{% if not loop.last %},{% endif %}{% endfor %}]
#eg.: - targets: ['host01:9100','host02:9100']
# Telegraf supports TLS mutual authN:
    scheme: https
    # Use to mutual authN to client:
    tls_config:
      cert_file: /opt/symas/ssl/{{ inventory_hostname }}.crt
      key_file: /opt/symas/ssl/{{ inventory_hostname }}.key
      ca_file: {{ cacert_path }}
      insecure_skip_verify: false
# Use basic authN instead:
#    basic_auth:
#      username: myuser
#      password: mypassword
alerting:
  alertmanagers:
  - static_configs:
    - targets:
      - 'localhost:9093'
rule_files:
  - "openldap_alerts.yml"
